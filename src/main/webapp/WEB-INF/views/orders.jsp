<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My orders | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><nav><a class="brand" href="${pageContext.request.contextPath}/products">ShopSphere</a><div><a href="${pageContext.request.contextPath}/products">Shop</a> <a href="${pageContext.request.contextPath}/cart">Cart</a></div></nav><main class="container"><h1>My orders</h1><c:choose><c:when test="${empty orders}"><p>No orders yet. <a href="${pageContext.request.contextPath}/products">Start shopping</a>.</p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th></tr></thead><tbody><c:forEach items="${orders}" var="o"><tr><td>#<c:out value="${o.id}"/></td><td><c:out value="${o.createdAt}"/></td><td><c:out value="${o.status}"/></td><td>₹<c:out value="${o.total}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></main></body></html>
