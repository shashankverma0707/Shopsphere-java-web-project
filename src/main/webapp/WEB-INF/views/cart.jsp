<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cart | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body>
<nav><a class="brand" href="${pageContext.request.contextPath}/products">ShopSphere</a><div><a href="${pageContext.request.contextPath}/products">Shop</a> <a href="${pageContext.request.contextPath}/orders">My orders</a></div></nav>
<main class="container"><h1>Your Cart</h1><c:if test="${not empty error}"><div class="alert"><c:out value="${error}"/></div></c:if><c:if test="${not empty sessionScope.cartError}"><div class="alert"><c:out value="${sessionScope.cartError}"/></div><c:remove var="cartError" scope="session"/></c:if>
<c:choose><c:when test="${empty cart}"><p>Your cart is empty. <a href="${pageContext.request.contextPath}/products">Browse products</a>.</p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Product</th><th>Quantity</th><th>Subtotal</th><th>Actions</th></tr></thead><tbody><c:set var="total" value="0"/><c:forEach var="entry" items="${cart}"><c:set var="item" value="${entry.value}"/><tr><td><c:out value="${item.product.name}"/></td><td><form method="post" action="${pageContext.request.contextPath}/cart" class="inline"><input type="hidden" name="id" value="${entry.key}"><input type="hidden" name="action" value="update"><input type="number" name="quantity" min="1" max="${item.product.stock}" value="${item.quantity}" style="width:78px"><button class="secondary">Update</button></form></td><td>₹<c:out value="${item.subtotal}"/></td><td><form method="post" action="${pageContext.request.contextPath}/cart" class="inline"><input type="hidden" name="id" value="${entry.key}"><input type="hidden" name="action" value="remove"><button class="danger">Remove</button></form></td></tr><c:set var="total" value="${total + item.subtotal}"/></c:forEach><tr><th colspan="2">Total</th><th colspan="2">₹<c:out value="${total}"/></th></tr></tbody></table></div><form method="post" action="${pageContext.request.contextPath}/checkout"><button class="primary">Place Order</button></form><p class="muted">Available stock is checked again at checkout.</p></c:otherwise></c:choose></main></body></html>
